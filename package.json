{
  "name": "contexto",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema profesional de gestión para psicólogos y consultorios psicológicos.",
  "author": "Frank Medina",
  "scripts": {
    "start": "npx serve . -s",
    "dev": "npx serve . -l 3000 -s",
    "lint": "eslint js config scripts",
    "lint:fix": "eslint js config scripts --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md,sql}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md,sql}\"",
    "check:syntax": "node --check js/core/app.js",
    "og-image": "node scripts/generate-og-image.js",
    "icons": "node scripts/generate-icons.js",
    "assets": "npm run og-image && npm run icons",
    "smoke": "node scripts/smoke-test.js",
    "verify": "npm run lint && npm run smoke",
    "test": "node scripts/smoke-test.js"
  },
  "devDependencies": {
    "serve": "^14.2.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}